{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irrigation-system/schemas/command-result.v1.json",
  "title": "CommandResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "deviceId", "status", "updatedAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": ["pending", "applied", "failed", "timeout"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time"
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "errorMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "failed" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["errorCode"]
      }
    }
  ]
}
