{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irrigation-system/schemas/command-envelope.v1.json",
  "title": "CommandEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "deviceId", "type", "issuedAt", "requestedBy", "payload"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "enum": ["line.set", "schedule.set", "logs.clear"]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload": {
      "type": "object",
      "description": "Type-specific payload; validated by cloud and device using command-specific schema.",
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": { "type": "string" },
        "sourceIp": { "type": "string" }
      }
    }
  }
}
